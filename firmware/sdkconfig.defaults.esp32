CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_LIBC_NEWLIB=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_PAN_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
# Reserve internal RAM for the radio, FreeRTOS and flash-writing stacks.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y
# Keep both Wi-Fi slots and use the third mDNS slot for Bluetooth PAN.
CONFIG_MDNS_PREDEF_NETIF_ETH=n
# The phone uses its own Internet connection. Do not route between the radios.
CONFIG_LWIP_IP_FORWARD=n
CONFIG_LWIP_IPV4_NAPT=n
